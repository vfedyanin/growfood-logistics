generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================================
//  ПОЛЬЗОВАТЕЛИ, РОЛИ, ПРАВА (табличный RBAC сохранён)
// ============================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roles               UserRole[]
  sessions            Session[]
  reportedQualityEvts QualityEvent[]
  auditLogs           AuditLog[]
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique // ADMIN, LOGISTICS_MANAGER, LAAS_MANAGER, OWN_DISPATCHER, WAREHOUSE_OPERATOR, RECEIVER_OPERATOR, ACCOUNTANT, VIEWER
  description String?

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id       String @id @default(cuid())
  code     String @unique
  name     String
  category String

  roles RolePermission[]
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
//  СПРАВОЧНИКИ
// ============================================================

// Чистый справочник — без полей аудита (по ТЗ)
model Vertical {
  code     String       @id // GROWFOOD, LAAS, RETAIL, PRIEM, VENDING
  name     String
  type     VerticalType
  isActive Boolean      @default(true)

  customers      Customer[]
  trips          Trip[]
  tripCargoUnits TripCargoUnit[]
  requests       CustomerRequest[]
}

enum VerticalType {
  INTERNAL
  EXTERNAL
}

model Location {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  type        LocationType
  ownerType   LocationOwnerType
  city        String?
  region      String?
  address     String?
  lat         Decimal?          @db.Decimal(9, 6)
  lon         Decimal?          @db.Decimal(9, 6)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdById String?
  updatedById String?

  tripsAsOrigin           Trip[]                     @relation("TripOrigin")
  tripsAsDestination      Trip[]                     @relation("TripDestination")
  customerDeliveries      CustomerDeliveryLocation[]
  legsAsOrigin            TripLeg[]                  @relation("LegOrigin")
  legsAsDestination       TripLeg[]                  @relation("LegDestination")
  requestsAsPickup        CustomerRequest[]          @relation("ReqPickup")
  requestsAsDelivery      CustomerRequest[]          @relation("ReqDelivery")
  reqLegAsPickup          RequestCargoLeg[]          @relation("RCLPickup")
  reqLegAsDropoff         RequestCargoLeg[]          @relation("RCLDropoff")
  routeStops              RouteStop[]                @relation("RouteStopLocation")
  tptLegsAsPickup         TripPlanTemplateLeg[]      @relation("TPTLegPickup")
  tptLegsAsDropoff        TripPlanTemplateLeg[]      @relation("TPTLegDropoff")
  tptLegsAsFinal          TripPlanTemplateLeg[]      @relation("TPTLegFinal")
  reqCargoAsConsignee     RequestCargo[]             @relation("RCConsigneeLocation")
  directionsAsOrigin      Direction[]                @relation("DirectionOrigin")
  directionsAsDestination Direction[]                @relation("DirectionDestination")
  tariffsAsOrigin         Tariff[]                   @relation("TariffOrigin")
  tariffsAsDestination    Tariff[]                   @relation("TariffDestination")
  schedulesAsOrigin       DirectionSchedule[]        @relation("ScheduleOrigin")
  schedulesAsDestination  DirectionSchedule[]        @relation("ScheduleDestination")
}

enum LocationType {
  WAREHOUSE
  HUB
  KITCHEN
  DC
  RETAIL_POINT
  FACTORY
}

enum LocationOwnerType {
  OWN
  CUSTOMER
  PARTNER
}

model Customer {
  id                String       @id @default(cuid())
  code              String       @unique
  name              String
  inn               String?      @unique
  kpp               String?
  fullLegalName     String?
  verticalCode      String
  customerType      CustomerType
  partyRole         PartyRole    @default(BOTH)
  contactPerson     String?
  phone             String?
  email             String?
  isActive          Boolean      @default(true)
  // Авто-импорт заявок из писем (PDF). Включается только при заполненном email.
  autoImportEnabled Boolean      @default(false)
  importSince       DateTime? // забирать только письма после этой даты (watermark по контрагенту)
  parserKey         String? // ключ парсера PDF для этого контрагента (напр. "korolevsky-vkus")
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  createdById       String?
  updatedById       String?

  vertical Vertical @relation(fields: [verticalCode], references: [code])

  contracts           CustomerContract[]
  ownedCargoUnits     CargoUnit[]
  tripsAsShipper      Trip[]                     @relation("TripShipper")
  tripsAsConsignee    Trip[]                     @relation("TripConsignee")
  tripsAsPayer        Trip[]                     @relation("TripPayer")
  tcuAsCustomer       TripCargoUnit[]            @relation("TCUCustomer")
  tcuAsShipper        TripCargoUnit[]            @relation("TCUShipper")
  requestsAsCustomer  CustomerRequest[]          @relation("ReqCustomer")
  requestsAsShipper   CustomerRequest[]          @relation("ReqShipper")
  requestsAsConsignee CustomerRequest[]          @relation("ReqConsignee")
  requestsAsPayer     CustomerRequest[]          @relation("ReqPayer")
  reqCargoAsConsignee RequestCargo[]             @relation("RCConsignee")
  acts                CustomerAct[]
  invoices            Invoice[]
  payments            Payment[]
  deliveryLocations   CustomerDeliveryLocation[]
  contractMemberships CustomerContractMember[]
  importLogs          ImportLog[]
}

model CustomerDeliveryLocation {
  id           String        @id @default(cuid())
  customerId   String
  locationId   String
  tariffMethod TariffMethod?
  tariffAmount Decimal?      @db.Decimal(10, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([customerId, locationId])
  @@index([customerId])
}

enum TariffMethod {
  PER_PALLET
  PER_TRIP
}

enum CustomerType {
  INTERNAL
  RETAIL_CHAIN
  EXTERNAL_COMPANY
}

enum PartyRole {
  SHIPPER
  CONSIGNEE
  BOTH
}

model Carrier {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  inn           String?
  kpp           String?
  contactPerson String?
  phone         String?
  email         String?
  isActive      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  updatedById   String?

  vehicles      Vehicle[]
  drivers       Driver[]
  directions    Direction[] // направления, закреплённые за перевозчиком
  contracts     CarrierContract[]
  trips         Trip[]
  acts          CarrierAct[]
  invoices      Invoice[]
  payments      Payment[]
  planTemplates TripPlanTemplate[]
}

// Чистый справочник — без полей аудита (по ТЗ)
model VehicleType {
  code            String   @id // VAN_3T, TRUCK_5T, TRUCK_10T, TRUCK_20T, REF_3T, REF_5T, REF_10T, REF_20T
  name            String
  capacityKg      Decimal? @db.Decimal(10, 2)
  capacityPallets Int?
  isRefrigerator  Boolean  @default(false)

  vehicles      Vehicle[]
  tariffs       Tariff[]
  marketPrices  MarketPrice[]
  trips         Trip[]             @relation("TripVehicleType")
  tariffTiers   TariffTier[]
  planTemplates TripPlanTemplate[]
}

model AdditionalService {
  code      String   @id // WAIT, RETURN, FORKLIFT, ESCORT, …
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id              String   @id @default(cuid())
  plateNumber     String   @unique
  brandModel      String?
  vehicleTypeCode String
  carrierId       String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?
  updatedById     String?

  vehicleType VehicleType @relation(fields: [vehicleTypeCode], references: [code])
  carrier     Carrier?    @relation(fields: [carrierId], references: [id])
  trips       Trip[]
}

model Driver {
  id            String   @id @default(cuid())
  fullName      String
  phone         String?
  licenseNumber String?
  carrierId     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  updatedById   String?

  carrier Carrier? @relation(fields: [carrierId], references: [id])
  trips   Trip[]
}

// ============================================================
//  КОНТРАКТЫ И ТАРИФЫ
// ============================================================

model CustomerContract {
  id             String       @id @default(cuid())
  // Номера сквозные по компании (Д-001/2026 …), поэтому уникальность глобальная
  contractNumber String       @unique
  customerId     String
  contractType   ContractType
  vatRatePct     Int          @default(0) // ставка НДС: 0(без НДС)/5/7/10/22
  validFrom      DateTime
  validTo        DateTime?
  paymentTerms   String?
  notes          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String?
  updatedById    String?

  customer  Customer                 @relation(fields: [customerId], references: [id])
  tariffs   Tariff[]                 @relation("CustContractTariff")
  acts      CustomerAct[]
  members   CustomerContractMember[]
  schedules DirectionSchedule[]
}

model CustomerContractMember {
  contractId String
  customerId String

  contract CustomerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  customer Customer         @relation(fields: [customerId], references: [id])

  @@id([contractId, customerId])
}

model DirectionSchedule {
  id                    String    @id @default(cuid())
  customerContractId    String
  directionId           String?
  originLocationId      String?
  destinationLocationId String?
  mon                   Int?
  tue                   Int?
  wed                   Int?
  thu                   Int?
  fri                   Int?
  sat                   Int?
  sun                   Int?
  requestTemplateId     String?
  // Историчность: график — правило, действующее в период, как и тариф.
  // Правка не меняет строку на месте, а закрывает её validTo и создаёт новую.
  validFrom             DateTime
  validTo               DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  customerContract    CustomerContract @relation(fields: [customerContractId], references: [id], onDelete: Cascade)
  direction           Direction?       @relation(fields: [directionId], references: [id])
  originLocation      Location?        @relation("ScheduleOrigin", fields: [originLocationId], references: [id])
  destinationLocation Location?        @relation("ScheduleDestination", fields: [destinationLocationId], references: [id])
  requestTemplate     RequestTemplate? @relation(fields: [requestTemplateId], references: [id])

  @@index([validFrom])
}

enum ContractType {
  LAAS_SERVICE
  RETAIL_SUPPLY
  INTERNAL_AGREEMENT
}

model CarrierContract {
  id             String    @id @default(cuid())
  contractNumber String    @unique
  carrierId      String
  vatRatePct     Int       @default(0) // ставка НДС: 0(без НДС)/5/7/10/22
  validFrom      DateTime
  validTo        DateTime?
  paymentTerms   String?
  notes          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?

  carrier Carrier  @relation(fields: [carrierId], references: [id])
  tariffs Tariff[] @relation("CarrContractTariff")
}

// Полиморфизм: ровно один из customerContractId / carrierContractId NOT NULL
// (CHECK-констрейнт добавляется отдельным SQL после db push)
model Tariff {
  id                 String       @id @default(cuid())
  customerContractId String?
  carrierContractId  String?
  directionId        String?      @map("routeId")
  vehicleTypeCode    String?
  tariffType         TariffMethod @default(PER_PALLET)
  pricePerTrip       Decimal?     @db.Decimal(12, 2)
  pricePerPallet     Decimal?     @db.Decimal(12, 2)
  pricePerKm         Decimal?     @db.Decimal(8, 2)
  validFrom          DateTime
  validTo            DateTime?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  createdById        String?
  updatedById        String?

  originLocationId      String?
  destinationLocationId String?

  customerContract    CustomerContract? @relation("CustContractTariff", fields: [customerContractId], references: [id])
  carrierContract     CarrierContract?  @relation("CarrContractTariff", fields: [carrierContractId], references: [id])
  direction           Direction?        @relation(fields: [directionId], references: [id])
  vehicleType         VehicleType?      @relation(fields: [vehicleTypeCode], references: [code])
  originLocation      Location?         @relation("TariffOrigin", fields: [originLocationId], references: [id])
  destinationLocation Location?         @relation("TariffDestination", fields: [destinationLocationId], references: [id])
  tiers               TariffTier[]
}

model TariffTier {
  id              String  @id @default(cuid())
  tariffId        String
  vehicleTypeCode String
  price           Decimal @db.Decimal(12, 2)

  tariff      Tariff      @relation(fields: [tariffId], references: [id], onDelete: Cascade)
  vehicleType VehicleType @relation(fields: [vehicleTypeCode], references: [code])
}

model MarketPrice {
  id              String    @id @default(cuid())
  directionId     String    @map("routeId")
  vehicleTypeCode String
  pricePerTrip    Decimal?  @db.Decimal(12, 2)
  pricePerPallet  Decimal?  @db.Decimal(12, 2)
  pricePerKm      Decimal?  @db.Decimal(8, 2)
  validFrom       DateTime
  validTo         DateTime?
  source          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?
  updatedById     String?

  direction   Direction   @relation(fields: [directionId], references: [id])
  vehicleType VehicleType @relation(fields: [vehicleTypeCode], references: [code])
}

// ============================================================
//  НАПРАВЛЕНИЯ
// ============================================================

// Режим набивки машин на направлении.
// OVERLOAD — всё в одну машину, даже с перебором (Пятёрочка НН).
// SPLIT — дробим по вместимости (Казань: 50–60 паллет в сутки — две фуры,
// а в пятницу меньше 33 и хватает одной).
enum SplitMode {
  OVERLOAD
  SPLIT
}

model Direction {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String?
  distanceKm    Decimal? @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  updatedById   String?
  originId      String?
  destinationId String?

  // Реквизиты автопланирования — ровно два.
  //
  // Перевозчик: одно направление — один перевозчик. Живёт здесь и не
  // версионируется: у Trip своё carrierId, оно копируется при создании рейса,
  // поэтому смена перевозчика в справочнике не переписывает историю.
  carrierId            String?
  // Режим набивки. Пусто = направление не настроено, автопланирование его не берёт.
  splitMode            SplitMode?
  //
  // ЧЕЙ РЕЙС ЗАБИРАЕТ ГРУЗ ЭТОГО НАПРАВЛЕНИЯ С ПРОИЗВОДСТВА.
  // Пусто = свой собственный рейс. Заполнено = заборное плечо (производство →
  // хаб) едет на машине ДРУГОГО направления, а из хаба груз уходит уже своим
  // рейсом. Стоимость забора при этом внутри тарифа того направления, отдельной
  // ставки нет — поэтому отдельное направление на забор не заводится.
  //
  // Пример: Трансхолод забирает с Йуми всё, что там лежит. Настройка «Казань →
  // забор везёт MSK-NN-5KA» кладёт казанский забор на машину Пятёрочки, а
  // «Воронеж → MSK-NN» — воронежский на машину Нижнего. Правило живёт в данных,
  // а не в коде: поменялись объёмы — переставили в справочнике.
  pickupViaDirectionId String?
  //
  // Типа ТС и вместимости здесь НЕТ намеренно. Список типов, которые перебирает
  // алгоритм, берётся из тарифов договора перевозчика на это направление: если у
  // перевозчика в тарифах только восьмипаллетки, фуры взяться неоткуда.
  // Вместимость каждого типа — из VehicleType.capacityPallets, в тарифе её нет.

  origin              Location?             @relation("DirectionOrigin", fields: [originId], references: [id])
  destination         Location?             @relation("DirectionDestination", fields: [destinationId], references: [id])
  carrier             Carrier?              @relation(fields: [carrierId], references: [id])
  // Self-relation: чей рейс забирает груз с производства (см. поле выше).
  pickupViaDirection  Direction?            @relation("DirectionPickupVia", fields: [pickupViaDirectionId], references: [id])
  pickupForDirections Direction[]           @relation("DirectionPickupVia")
  trips               Trip[]
  tariffs             Tariff[]
  marketPrices        MarketPrice[]
  legs                RequestCargoLeg[]
  schedules           DirectionSchedule[]
  stops               RouteStop[]
  planTemplateLegs    TripPlanTemplateLeg[]

  @@map("Route")
}

// Каркас маршрута направления: упорядоченный список точек, которые машина
// объезжает (Йуми → КД Север → КД НН → ЯЛ НН → Самокат НН). Это МАКСИМАЛЬНЫЙ
// маршрут; автораспределение раскладывает фактические плечи дня в этом порядке,
// а точки без груза пропускает. Порядок остановок берётся ОТСЮДА, времена — из
// окон плеч заявки (plannedPickup/Dropoff), отдельного окна на точке нет.
// Направление без остановок автоматика обрабатывает по-старому (пара точек).
model RouteStop {
  id          String   @id @default(cuid())
  directionId String
  locationId  String
  position    Int // порядок объезда, 1 = первый заезд
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  direction Direction @relation(fields: [directionId], references: [id], onDelete: Cascade)
  location  Location  @relation("RouteStopLocation", fields: [locationId], references: [id])

  @@unique([directionId, position])
  @@index([directionId])
}

// ============================================================
//  ТРАНЗАКЦИОННЫЕ
// ============================================================

model Trip {
  id               String     @id @default(cuid())
  tripNumber       String     @unique
  tripType         TripType
  // Перечисление фактических вертикалей груза рейса: MONO — один элемент,
  // MIX — несколько. «MONO/MIX» не храним, это следствие длины списка.
  // tripType выше остаётся свёрткой этого перечисления (см. tripFactory):
  // существующие рейсы не пересчитывались, поэтому фильтры и права по-прежнему
  // опираются на tripType, а у старых рейсов verticalCodes пуст.
  verticalCodes    String[]
  verticalCode     String?
  directionId      String?    @map("routeId")
  originId         String?
  destinationId    String?
  vehicleTypeCode  String?
  vehicleId        String?
  driverId         String?
  carrierId        String?
  shipperId        String?
  consigneeId      String?
  payerId          String?
  plannedDeparture DateTime?
  plannedArrival   DateTime?
  actualDeparture  DateTime?
  actualArrival    DateTime?
  plannedPallets   Int?
  actualPallets    Int?
  plannedWeightKg  Decimal?   @db.Decimal(10, 2)
  actualWeightKg   Decimal?   @db.Decimal(10, 2)
  actualCost       Decimal?   @db.Decimal(12, 2)
  vatRatePct       Int?       @default(0)
  status           TripStatus @default(DRAFT)
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  createdById      String?
  updatedById      String?

  vertical    Vertical?    @relation(fields: [verticalCode], references: [code])
  direction   Direction?   @relation(fields: [directionId], references: [id])
  origin      Location?    @relation("TripOrigin", fields: [originId], references: [id])
  destination Location?    @relation("TripDestination", fields: [destinationId], references: [id])
  vehicleType VehicleType? @relation("TripVehicleType", fields: [vehicleTypeCode], references: [code])
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id])
  driver      Driver?      @relation(fields: [driverId], references: [id])
  carrier     Carrier?     @relation(fields: [carrierId], references: [id])
  shipper     Customer?    @relation("TripShipper", fields: [shipperId], references: [id])
  consignee   Customer?    @relation("TripConsignee", fields: [consigneeId], references: [id])
  payer       Customer?    @relation("TripPayer", fields: [payerId], references: [id])

  legs          TripLeg[]
  cargoUnits    TripCargoUnit[]
  qualityEvents QualityEvent[]
  actTripLinks  ActTripLink[]
  invoices      Invoice[]

  @@index([plannedDeparture])
  @@index([status])
  @@index([shipperId])
  @@index([consigneeId])
  @@index([payerId])
  @@index([carrierId])
}

enum TripType {
  OWN
  LAAS
  CONSOLIDATED
}

enum TripStatus {
  DRAFT
  PLANNED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model TripLeg {
  id               String    @id @default(cuid())
  tripId           String
  legOrder         Int
  originId         String
  destinationId    String
  plannedDeparture DateTime?
  plannedArrival   DateTime?
  actualDeparture  DateTime?
  actualArrival    DateTime?
  distanceKm       Decimal?  @db.Decimal(10, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?
  updatedById      String?

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  origin      Location @relation("LegOrigin", fields: [originId], references: [id])
  destination Location @relation("LegDestination", fields: [destinationId], references: [id])

  @@index([tripId])
}

model CargoUnit {
  id              String        @id @default(cuid())
  barcode         String?       @unique
  unitType        CargoUnitType
  ownerCustomerId String?
  palletType      PalletType?
  isReturnable    Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?
  updatedById     String?

  owner          Customer?       @relation(fields: [ownerCustomerId], references: [id])
  tripCargoUnits TripCargoUnit[]
}

enum CargoUnitType {
  PALLET
  BOX
  CARTON
}

enum PalletType {
  EURO
  AMERICAN
  STANDARD
}

model TripCargoUnit {
  id              String           @id @default(cuid())
  tripId          String
  cargoUnitId     String?
  verticalCode    String?
  customerId      String?
  shipperId       String?
  unitType        CargoUnitType
  pallets         Int?
  boxes           Int?
  traysCount      Int?
  weightKg        Decimal?         @db.Decimal(10, 2)
  productCategory ProductCategory?
  tempRegime      TempRegime?
  tempRequiredMin Decimal?         @db.Decimal(4, 1)
  tempRequiredMax Decimal?         @db.Decimal(4, 1)
  requestId       String?
  notes           String?
  // Ручной порядок остановок ВНУТРИ рейса. Пусто = порядок не задавали руками,
  // тогда он считается как раньше: позиция точки в маршруте направления
  // (RouteStop), иначе время плеча. Заполнено — ПЕРЕОПРЕДЕЛЯЕТ маршрут: логисту
  // нужно уметь переставить точки в отдельном рейсе, не меняя справочник.
  stopOrder       Int?
  costSharePct    Decimal?         @db.Decimal(7, 4)
  allocatedCost   Decimal?         @db.Decimal(12, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?
  updatedById     String?

  trip            Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  cargoUnit       CargoUnit?       @relation(fields: [cargoUnitId], references: [id])
  vertical        Vertical?        @relation(fields: [verticalCode], references: [code])
  customer        Customer?        @relation("TCUCustomer", fields: [customerId], references: [id])
  shipper         Customer?        @relation("TCUShipper", fields: [shipperId], references: [id])
  request         CustomerRequest? @relation(fields: [requestId], references: [id])
  requestCargoLeg RequestCargoLeg?

  @@index([tripId])
}

enum ProductCategory {
  READY_FOOD
  RAW
  EQUIPMENT
  CONFECTIONERY
  OTHER
}

enum TempRegime {
  FROZEN
  COOLED
  AMBIENT
}

model CustomerRequest {
  id                 String           @id @default(cuid())
  requestNumber      String           @unique
  customerId         String
  payerId            String?
  verticalCode       String?
  shipperId          String?
  consigneeId        String?
  pickupLocationId   String?
  deliveryLocationId String?
  requestDate        DateTime?
  pickupDate         DateTime?
  pickupTimeFrom     String?
  pickupTimeTo       String?
  deliveryDate       DateTime?
  deliveryTimeFrom   String?
  deliveryTimeTo     String?
  requestedPallets   Int?
  requestedWeightKg  Decimal?         @db.Decimal(10, 2)
  traysCount         Int?
  productCategory    ProductCategory?
  tempRegime         TempRegime?
  status             RequestStatus    @default(NEW)
  source             RequestSource    @default(MANUAL)
  perTripScope       PerTripScope     @default(CARGO)
  notes              String?
  clientUpd          String?
  transportNote      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  createdById        String?
  updatedById        String?

  parentRequestId String?
  parent          CustomerRequest?  @relation("RequestGroup", fields: [parentRequestId], references: [id], onDelete: SetNull)
  groupChildren   CustomerRequest[] @relation("RequestGroup")

  customer         Customer       @relation("ReqCustomer", fields: [customerId], references: [id])
  payer            Customer?      @relation("ReqPayer", fields: [payerId], references: [id])
  vertical         Vertical?      @relation(fields: [verticalCode], references: [code])
  shipper          Customer?      @relation("ReqShipper", fields: [shipperId], references: [id])
  consignee        Customer?      @relation("ReqConsignee", fields: [consigneeId], references: [id])
  pickupLocation   Location?      @relation("ReqPickup", fields: [pickupLocationId], references: [id])
  deliveryLocation Location?      @relation("ReqDelivery", fields: [deliveryLocationId], references: [id])
  cargoes          RequestCargo[]
  invoices         Invoice[]

  tripCargoUnits TripCargoUnit[]
}

enum RequestStatus {
  NEW
  CONFIRMED
  IN_PLANNING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

// Источник заявки: вручную оператором или авто-импорт из письма (PDF).
enum RequestSource {
  MANUAL
  EMAIL_IMPORT
}

