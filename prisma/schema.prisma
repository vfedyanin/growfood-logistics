// ============================================================
//  ШАБЛОН РЕЙСА ДЛЯ АВТОПЛАНА (жёсткий каркас одной машины)
// ============================================================
//
// Одна запись = одна машина с ФИКСИРОВАННЫМ набором плеч. День ото дня меняются
// только дата и количество паллет — состав точек задан заранее. Автоплан на дату
// берёт заявочные плечи, совпадающие со слотом ПО ОБЕИМ ТОЧКАМ (забор+выгрузка),
// собирает их в один рейс. Перебор вместимости НЕ блокирует создание (создаётся с
// флагом), деление на две машины автоматом не делается — это ручная работа логиста.
//
// Проход по шаблонам идёт ПЕРВЫМ и добавочно: он забирает свои плечи, а всё
// остальное дораспределяет старый автоплан по направлениям (Direction.carrierId +
// splitMode + тариф). Так Казань и прочие рабочие направления не ломаются, а
// шаблон спасает то, что сейчас выпадает — забор с производств (MSK-MSK без
// перевозчика).
model TripPlanTemplate {
  id              String   @id @default(cuid())
  name            String   @unique
  carrierId       String
  vehicleTypeCode String // вместимость берётся из VehicleType.capacityPallets
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?
  updatedById     String?

  carrier     Carrier               @relation(fields: [carrierId], references: [id])
  vehicleType VehicleType           @relation(fields: [vehicleTypeCode], references: [code])
  legs        TripPlanTemplateLeg[]

  @@index([carrierId])
}

// Слот шаблона — одно фиксированное плечо: пара точек забор→выгрузка.
model TripPlanTemplateLeg {
  id                String  @id @default(cuid())
  templateId        String
  position          Int // порядок объезда в маршруте, 1 = первый
  pickupLocationId  String
  dropoffLocationId String
  directionId       String? // опционально: для тарифа/группировки
  // Конечная точка груза — третий ключ матча. Одно и то же заборное плечо
  // (Йуми → КД Север) едет разным клиентам; по паре точек их не различить,
  // поэтому слот уточняет, ЧЕЙ забор он берёт: пусто = любой, заполнено =
  // только груз с этой конечной точкой. Так забор Йуми делится между машиной
  // Пятёрочки (конечные Пятёрочка/Казань) и машиной Нижнего (Нижний/Воронеж).
  finalLocationId   String?

  template        TripPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  pickupLocation  Location         @relation("TPTLegPickup", fields: [pickupLocationId], references: [id])
  dropoffLocation Location         @relation("TPTLegDropoff", fields: [dropoffLocationId], references: [id])
  finalLocation   Location?        @relation("TPTLegFinal", fields: [finalLocationId], references: [id])
  direction       Direction?       @relation(fields: [directionId], references: [id])

  @@unique([templateId, position])
  @@index([templateId])
  @@index([pickupLocationId, dropoffLocationId])
}

// Грузы заявки (строки): точки забора/выгрузки, плановые даты, стоимость/скидка/итого
model RequestCargo {
  id                  String           @id @default(cuid())
  requestId           String
  consigneeId         String?
  consigneeLocationId String?
  unitType            CargoUnitType    @default(PALLET)
  pallets             Int?
  traysCount          Int?
  weightKg            Decimal?         @db.Decimal(10, 2)
  productCategory     ProductCategory?
  tempRegime          TempRegime?
  pricingMode         CargoPricingMode @default(CARGO)
  cost                Decimal?         @db.Decimal(12, 2)
  discount            Decimal?         @db.Decimal(12, 2)
  finalCost           Decimal?         @db.Decimal(12, 2)
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  createdById         String?
  updatedById         String?

  request           CustomerRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  consignee         Customer?         @relation("RCConsignee", fields: [consigneeId], references: [id])
  consigneeLocation Location?         @relation("RCConsigneeLocation", fields: [consigneeLocationId], references: [id])
  legs              RequestCargoLeg[]

  @@index([requestId])
}

enum CargoPricingMode {
  CARGO
  LEG
  TARIFF
}

// Как распределяется фикс-тариф PER_TRIP по грузам заявки:
// CARGO — полная ставка точки на каждый PER_TRIP-груз;
// REQUEST — одна сумма на заявку (Σ ставок уникальных точек ÷ число PER_TRIP-грузов).
enum PerTripScope {
  CARGO
  REQUEST
}

// Плечо маршрута груза: один отрезок забор→выгрузка, привязывается к своему рейсу
model RequestCargoLeg {
  id                String    @id @default(cuid())
  requestCargoId    String
  legOrder          Int       @default(1)
  pickupLocationId  String?
  dropoffLocationId String?
  plannedPickup     DateTime?
  plannedPickupTo   String?
  plannedDropoff    DateTime?
  plannedDropoffTo  String?
  cost              Decimal?  @db.Decimal(12, 2)
  discount          Decimal?  @db.Decimal(12, 2)
  finalCost         Decimal?  @db.Decimal(12, 2)
  tripCargoUnitId   String?   @unique
  directionId       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String?
  updatedById       String?

  cargo           RequestCargo   @relation(fields: [requestCargoId], references: [id], onDelete: Cascade)
  pickupLocation  Location?      @relation("RCLPickup", fields: [pickupLocationId], references: [id])
  dropoffLocation Location?      @relation("RCLDropoff", fields: [dropoffLocationId], references: [id])
  tripCargoUnit   TripCargoUnit? @relation(fields: [tripCargoUnitId], references: [id])
  direction       Direction?     @relation(fields: [directionId], references: [id])

  @@index([requestCargoId])
}

// Шаблоны заполнения формы заявки
model RequestTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  schedules DirectionSchedule[]
}

// ============================================================
//  АВТО-ИМПОРТ ЗАЯВОК ИЗ ПИСЕМ (PDF)
// ============================================================

// Журнал прогонов импорта: проверка почты, OCR, парсинг, создание заявок.
model ImportLog {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  trigger        ImportTrigger // как запущено: вручную / крон
  customerId     String?
  source         String? // имя файла / тема письма / message-id
  status         ImportStatus // итог прогона
  stage          String? // где остановились: mail | ocr | parse | create
  ocrChars       Int?
  createdCount   Int           @default(0)
  createdNumbers String[] // номера созданных заявок
  message        String? // краткое человекочитаемое резюме
  details        Json? // полный результат: извлечённые данные, warnings, errors, skipped
  createdById    String?

  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([createdAt])
  @@index([customerId])
}

enum ImportTrigger {
  MANUAL
  CRON
}

enum ImportStatus {
  SUCCESS // созданы заявки
  PARTIAL // часть создана, часть с ошибками
  EMPTY // писем/заявок к созданию нет (или все дубли)
  ERROR // ошибка почты/OCR/парсинга — ничего не создано
}
