model Invoice {
  id                   String           @id @default(cuid())
  invoiceNumber        String
  invoiceDate          DateTime
  direction            InvoiceDirection
  customerId           String?
  carrierId            String?
  customerActId        String?
  carrierActId         String?
  requestId            String?
  tripId               String?
  carrierInvoiceNumber String?
  amount               Decimal          @db.Decimal(14, 2)
  vatAmount            Decimal?         @db.Decimal(14, 2)
  total                Decimal          @db.Decimal(14, 2)
  dueDate              DateTime?
  status               InvoiceStatus    @default(ISSUED)
  fileUrl              String?
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  createdById          String?
  updatedById          String?

  customer    Customer?        @relation(fields: [customerId], references: [id])
  carrier     Carrier?         @relation(fields: [carrierId], references: [id])
  customerAct CustomerAct?     @relation(fields: [customerActId], references: [id])
  carrierAct  CarrierAct?      @relation(fields: [carrierActId], references: [id])
  request     CustomerRequest? @relation(fields: [requestId], references: [id])
