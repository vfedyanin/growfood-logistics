enum QualityEventType {
  LATE_DEPARTURE
  LATE_ARRIVAL
  TEMP_VIOLATION
  CARGO_DAMAGE
  ROUTE_DEVIATION
  VEHICLE_BREAKDOWN
  DOCUMENTATION_ISSUE
